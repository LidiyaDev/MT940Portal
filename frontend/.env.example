# Backend base URL. Leave empty to use the Vite dev proxy (/api -> :8080).
VITE_API_BASE_URL=

# Set to false once the Spring Boot backend is running.
VITE_USE_MOCK=true

# Keycloak (only used when VITE_KEYCLOAK_ENABLED=true)
VITE_KEYCLOAK_ENABLED=false
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=mt940
VITE_KEYCLOAK_CLIENT_ID=mt940-portal-ui
